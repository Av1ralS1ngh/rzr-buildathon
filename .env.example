# App
NEXT_PUBLIC_APP_URL=http://localhost:43123
PORT=43123
SPELOCK_INTERNAL_SECRET=change-me-in-production
MANDATE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
ACP_API_KEY=

# Database (Neon Postgres in production; omit to use local SQLite)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Razorpay (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxx
ALLOW_MOCK_PAYMENTS=false

# x402 facilitator (public default still 402s until X402_PAY_TO is a funded Base Sepolia USDC address)
X402_NETWORK=eip155:84532
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_FACILITATOR_TOKEN=
X402_USDC_ADDRESS=0x036CbD53842cFd8590b1C631E3ac9657c6c6d4d4
X402_DEMO_AGENT_KEY=speclock-demo-agent

# LLM RFQ parser (optional — falls back to the rules extractor; never prices)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# NEON_AI_API_KEY=

# Enfocus PitStop / pdfToolbox HTTP preflight (optional — local PDF/PNG/JPEG inspector always runs)
ENFOCUS_PREFLIGHT_URL=
ENFOCUS_API_KEY=
